          </div>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <footer
      class="footer footer-center p-6 bg-base-300 text-base-content border-t border-base-200"
    >
      <div class="flex items-center gap-2">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5 text-green-600"
          fill="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.569-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.686"
          />
        </svg>
        <span class="font-semibold text-sm">WhatsApp API Gateway</span>
        <span class="text-xs text-base-content/50"
          >&bull; Panel Kontrol Sistem</span
        >
      </div>
    </footer>

    <script src="/p/js/theme-toggle.js"></script>
    <script>
      const qr = "<%= typeof qr !== 'undefined' && qr ? qr : '' %>";
      const session = "<%= typeof session !== 'undefined' && session ? session : '' %>";
      const alreadyConnected = <%= typeof alreadyConnected !== 'undefined' && alreadyConnected ? 'true' : 'false' %>;
      const initialError = "<%= typeof error !== 'undefined' && error ? error : '' %>";

      const qrContainer = document.getElementById("qrcode");
      const loading = document.getElementById("loading");
      const success = document.getElementById("success");
      const error = document.getElementById("error");
      const errorMessage = document.getElementById("error-message");

      let pollInterval = null;
      let refreshTimeout = null;
      let isTerminated = false;

      function showSuccess(msg) {
        if (isTerminated) return;
        isTerminated = true;
        if (pollInterval) clearInterval(pollInterval);
        if (refreshTimeout) clearTimeout(refreshTimeout);
        loading.classList.add("hidden");
        qrContainer.classList.add("hidden");
        error.classList.add("hidden");
        if (msg) {
          const p = success.querySelector("p");
          if (p) p.textContent = msg;
        }
        success.classList.remove("hidden");
      }

      function showError(msg) {
        if (isTerminated) return;
        if (pollInterval) clearInterval(pollInterval);
        if (refreshTimeout) clearTimeout(refreshTimeout);
        loading.classList.add("hidden");
        qrContainer.classList.add("hidden");
        success.classList.add("hidden");
        if (msg && errorMessage) errorMessage.textContent = msg;
        error.classList.remove("hidden");
      }

      function checkStatus() {
        if (!session || isTerminated) return;
        fetch(`/session-status?session=${encodeURIComponent(session)}`)
          .then((res) => res.json())
          .then((data) => {
            const status = data?.data?.status;
            const isReady = data?.data?.is_ready;
            if (status === "connected" || status === "ready" || isReady) {
              showSuccess("Sesi WhatsApp berhasil terhubung! Mengalihkan ke dashboard...");
              setTimeout(() => {
                window.location.href = "/";
              }, 2000);
            }
          })
          .catch(() => {});
      }

      if (alreadyConnected) {
        showSuccess("Sesi WhatsApp sudah terhubung dan siap digunakan.");
      } else if (initialError) {
        showError(initialError);
      } else if (qr) {
        const image = new Image();
        image.src = qr;
        image.className = "rounded-lg shadow-lg max-w-full h-auto mx-auto";
        image.alt = "WhatsApp QR Code";

        image.onload = function () {
          loading.classList.add("hidden");
          qrContainer.classList.remove("hidden");
          qrContainer.innerHTML = "";
          qrContainer.appendChild(image);

          // Polling status secara periodik (setiap 2.5 detik)
          pollInterval = setInterval(checkStatus, 2500);

          // Batasi refresh QR setelah 30 detik
          refreshTimeout = setTimeout(() => {
            fetch(`/session-status?session=${encodeURIComponent(session)}`)
              .then((res) => res.json())
              .then((data) => {
                const status = data?.data?.status;
                const isReady = data?.data?.is_ready;
                if (status === "connected" || status === "ready" || isReady) {
                  showSuccess("Sesi WhatsApp berhasil terhubung!");
                } else {
                  loading.classList.remove("hidden");
                  qrContainer.classList.add("hidden");
                  window.location.reload();
                }
              })
              .catch(() => {
                window.location.reload();
              });
          }, 30000);
        };

        image.onerror = function () {
          showError("Gagal memuat gambar QR Code.");
        };
      } else {
        showError("QR Code belum tersedia atau waktu permintaan habis. Silakan muat ulang.");
      }
    </script>
  </body>
</html>
