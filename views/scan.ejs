    <!-- Hero Section -->
    <div
      class="bg-gradient-to-r from-blue-700 to-indigo-800 text-white py-10 px-4 shadow-inner"
    >
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-3xl font-bold mb-3 tracking-tight">Pindai QR Code</h1>
        <p class="text-sm sm:text-base opacity-90 max-w-xl mx-auto mb-5">
          Buka aplikasi WhatsApp di ponsel Anda dan pindai QR Code di bawah
          untuk menautkan sesi perangkat.
        </p>
        <div>
          <a
