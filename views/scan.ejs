              </div>

              <!-- QR Code Display -->
              <div
                id="qrcode"
                class="hidden p-4 bg-white rounded-xl border border-base-300 shadow-inner"
              >
                <!-- QR Image will be inserted here -->
              </div>

              <!-- Success State -->
              <div id="success" class="hidden text-center py-8">
                <div
                  class="w-16 h-16 rounded-full bg-success/10 text-success mx-auto flex items-center justify-center mb-3"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-8 w-8"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M5 13l4 4L19 7"
                    />
                  </svg>
                </div>
                <h3 class="text-lg font-bold text-success mb-1">
                  Berhasil Terhubung
                </h3>
                <p class="text-xs text-base-content/70">
                  Sesi WhatsApp aktif dan siap digunakan untuk pengiriman pesan.
                </p>
                <a href="/" class="btn btn-primary btn-sm mt-4 font-semibold"
                  >Buka Dashboard</a
                >
              </div>

              <!-- Error State -->
              <div id="error" class="hidden text-center py-8">
