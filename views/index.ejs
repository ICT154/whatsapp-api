<!DOCTYPE html>
<html lang="en" data-theme="light">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WhatsApp API Gateway</title>
  <link href="/p/css/style.css" rel="stylesheet">
</head>

<body class="min-h-screen bg-base-200">
  <!-- Header -->
  <div class="navbar bg-base-100 shadow-sm border-b border-base-300 px-4">
    <div class="navbar-start">
      <a href="/" class="btn btn-ghost text-lg font-bold flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-green-600" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.569-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.686" />
        </svg>
        <span>WhatsApp Gateway</span>
      </a>
    </div>
    <div class="navbar-end flex items-center gap-2">
      <div class="badge badge-success badge-sm gap-1.5 font-medium py-2.5">
        <span class="w-1.5 h-1.5 bg-white rounded-full"></span>
        Online
      </div>
      <button id="theme-toggle" class="btn btn-ghost btn-circle btn-sm" title="Ganti Tema">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>
      <a href="/logout" class="btn btn-outline btn-sm gap-1.5 ml-2 font-medium" title="Keluar">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
        </svg>
        <span>Logout</span>
      </a>
    </div>
  </div>

  <!-- Hero Section -->
  <div class="bg-gradient-to-r from-emerald-700 to-teal-800 text-white py-12 px-4 shadow-inner">
    <div class="max-w-5xl mx-auto text-center">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-3">WhatsApp API Gateway</h1>
      <p class="text-base sm:text-lg opacity-90 max-w-2xl mx-auto mb-6">
        Layanan API untuk pengiriman pesan teks, gambar, dan dokumen WhatsApp dengan dukungan multi-sesi.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="#session-management" class="btn btn-sm sm:btn-md bg-white text-emerald-800 hover:bg-gray-100 border-none font-semibold">
          Manajemen Sesi
        </a>
        <a href="#api-reference" class="btn btn-sm sm:btn-md btn-outline text-white border-white hover:bg-white/10 font-semibold">
          Dokumentasi API
        </a>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <div class="container mx-auto px-4 py-12 max-w-6xl">

    <!-- Quick Features -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
      <div class="card bg-base-100 shadow-sm border border-base-300">
        <div class="card-body p-5">
          <div class="w-10 h-10 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>
          <h3 class="card-title text-base font-semibold">Multi Session</h3>
          <p class="text-sm text-base-content/70">Mendukung koneksi beberapa nomor WhatsApp secara bersamaan.</p>
        </div>
      </div>
      <div class="card bg-base-100 shadow-sm border border-base-300">
        <div class="card-body p-5">
          <div class="w-10 h-10 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="card-title text-base font-semibold">Performa Stabil</h3>
          <p class="text-sm text-base-content/70">Pengiriman pesan cepat dengan queue non-blocking dan delay rate.</p>
        </div>
      </div>
      <div class="card bg-base-100 shadow-sm border border-base-300">
        <div class="card-body p-5">
          <div class="w-10 h-10 rounded-lg bg-purple-100 text-purple-700 flex items-center justify-center mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
            </svg>
          </div>
          <h3 class="card-title text-base font-semibold">Integrasi Fleksibel</h3>
          <p class="text-sm text-base-content/70">API RESTful sederhana yang kompatibel dengan cURL, Node, PHP, Python, dll.</p>
        </div>
      </div>
    </div>

    <!-- Session Management -->
    <div id="session-management" class="mb-12">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-2xl font-bold tracking-tight text-base-content">Manajemen Sesi</h2>
          <p class="text-sm text-base-content/70">Kelola dan pantau status koneksi nomor WhatsApp aktif</p>
        </div>
      </div>

      <div class="card bg-base-100 shadow-md border border-base-300">
        <div class="card-body p-6">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

            <!-- Create Session -->
            <div>
              <div class="flex items-center gap-2 mb-4">
                <span class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center text-xs font-bold">1</span>
                <h3 class="text-base font-bold text-base-content">Mulai Sesi Baru</h3>
              </div>
              <div class="form-control space-y-4">
                <div>
                  <label class="label pb-1" for="sessionName">
                    <span class="label-text text-sm font-medium">Nama Sesi (Session ID)</span>
                  </label>
                  <input type="text" id="sessionName" placeholder="Contoh: main, cs-support"
                    class="input input-bordered w-full text-sm" value="main">
                  <span class="text-xs text-base-content/60 mt-1 block">Gunakan alfanumerik tanpa spasi.</span>
                </div>
                <button onclick="createSession()" class="btn btn-primary w-full text-sm font-semibold">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24"
                    stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                  </svg>
                  Generate QR & Tautkan Perangkat
                </button>
              </div>
            </div>

            <!-- Session Status -->
            <div>
              <div class="flex items-center gap-2 mb-4">
                <span class="w-6 h-6 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center text-xs font-bold">2</span>
                <h3 class="text-base font-bold text-base-content">Pemeriksaan Status</h3>
              </div>
              <div class="space-y-3">
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
                  <button onclick="checkSessions()" class="btn btn-outline btn-sm text-xs">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 mr-1" fill="none" viewBox="0 0 24 24"
                      stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                    </svg>
                    Daftar Sesi
                  </button>
                  <button onclick="checkDetailedStatus()" class="btn btn-primary btn-sm text-xs">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 mr-1" fill="none" viewBox="0 0 24 24"
                      stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    Cek Status
                  </button>
                  <button onclick="disconnectSession()" class="btn btn-error btn-outline btn-sm text-xs">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 mr-1" fill="none" viewBox="0 0 24 24"
                      stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                    </svg>
                    Putus Sesi
                  </button>
                </div>
                <button onclick="testEndpoint()" class="btn btn-ghost btn-xs w-full text-xs text-base-content/60">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                  Buka Endpoint /sessions di Tab Baru
                </button>
                <div id="sessionStatus" class="text-sm bg-base-200 border border-base-300 p-4 rounded-lg">
                  <div class="text-center text-base-content/60 text-xs py-2">Klik tombol di atas untuk memeriksa status sesi</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- API Reference & Interactive Testing -->
    <div id="api-reference" class="mb-12">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6">
        <div>
          <h2 class="text-2xl font-bold tracking-tight text-base-content">Dokumentasi & Uji Coba API</h2>
          <p class="text-xs sm:text-sm text-base-content/70">Uji seluruh endpoint langsung dari antarmuka ini tanpa perlu Postman</p>
        </div>
        <!-- Quick Filter -->
        <div class="join">
          <button onclick="filterApiCards('all')" class="btn btn-xs join-item api-filter-btn btn-active" data-filter="all">Semua</button>
          <button onclick="filterApiCards('message')" class="btn btn-xs join-item api-filter-btn" data-filter="message">Pesan Tunggal</button>
          <button onclick="filterApiCards('bulk')" class="btn btn-xs join-item api-filter-btn" data-filter="bulk">Pesan Massal</button>
          <button onclick="filterApiCards('session')" class="btn btn-xs join-item api-filter-btn" data-filter="session">Sesi</button>
        </div>
      </div>

      <div class="space-y-6">

        <!-- 1. Send Message (Text) -->
        <div class="card bg-base-100 shadow-sm border border-base-300 api-card" data-category="message">
          <div class="card-body p-5 sm:p-6">
            <div class="flex flex-wrap items-center justify-between gap-2 pb-3 border-b border-base-300">
              <div class="flex items-center gap-2">
                <span class="badge badge-success font-mono font-bold text-xs text-white">POST</span>
                <code class="text-sm font-mono font-bold text-base-content">/send-message</code>
              </div>
              <span class="text-xs text-base-content/60">Kirim Pesan Teks WhatsApp</span>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-4">
              <!-- Form Parameters -->
              <div class="space-y-3">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  <div>
                    <label class="label pb-1"><span class="label-text text-xs font-semibold">Session ID</span></label>
                    <input type="text" id="api-send-msg-session" value="main" class="input input-bordered input-sm w-full font-mono text-xs">
                  </div>
                  <div>
                    <label class="label pb-1"><span class="label-text text-xs font-semibold">Nomor Tujuan (to)</span></label>
                    <input type="text" id="api-send-msg-to" placeholder="6281234567890" class="input input-bordered input-sm w-full font-mono text-xs">
                  </div>
                </div>

                <div>
                  <label class="label pb-1"><span class="label-text text-xs font-semibold">Isi Pesan (text)</span></label>
                  <textarea id="api-send-msg-text" rows="3" class="textarea textarea-bordered textarea-sm w-full text-xs" placeholder="Halo! Ini pesan tes dari WhatsApp Gateway.">Halo! Ini pesan tes dari WhatsApp API Gateway.</textarea>
                </div>

                <div class="flex items-center justify-between pt-1">
                  <label class="cursor-pointer label p-0 gap-2">
                    <input type="checkbox" id="api-send-msg-group" class="checkbox checkbox-sm checkbox-primary">
                    <span class="label-text text-xs">Kirim ke Grup WhatsApp (isGroup)</span>
                  </label>
                  <button id="btn-test-send-msg" onclick="testSendMessage()" class="btn btn-primary btn-sm text-xs font-semibold px-4">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                    </svg>
                    Kirim Request
                  </button>
                </div>
              </div>

              <!-- Response Box & cURL Reference -->
              <div class="space-y-2">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-bold text-base-content">Hasil Response:</span>
                  <div class="tabs tabs-boxed py-0 px-1 bg-base-200">
                    <button class="tab tab-xs tab-active" onclick="switchTab(this, 'resp-box-send-msg', 'curl-box-send-msg')">Response</button>
                    <button class="tab tab-xs" onclick="switchTab(this, 'curl-box-send-msg', 'resp-box-send-msg')">cURL</button>
                  </div>
                </div>
                <div id="resp-box-send-msg">
                  <div class="rounded-lg border border-dashed border-base-300 bg-base-200/50 p-6 text-center text-xs text-base-content/60">
                    Isi parameter di samping dan klik "Kirim Request" untuk melihat respons API.
                  </div>
                </div>
                <div id="curl-box-send-msg" class="hidden">
                  <div class="mockup-code text-xs">
                    <pre data-prefix="$"><code>curl -X POST http://localhost:5001/send-message \</code></pre>
                    <pre data-prefix=""><code>  -H "Content-Type: application/json" \</code></pre>
                    <pre data-prefix=""><code>  -d '{"session":"main","to":"6281234567890","text":"Halo!"}'</code></pre>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- 2. Send Image -->
        <div class="card bg-base-100 shadow-sm border border-base-300 api-card" data-category="message">
          <div class="card-body p-5 sm:p-6">
            <div class="flex flex-wrap items-center justify-between gap-2 pb-3 border-b border-base-300">
              <div class="flex items-center gap-2">
                <span class="badge badge-success font-mono font-bold text-xs text-white">POST</span>
                <code class="text-sm font-mono font-bold text-base-content">/send-image</code>
              </div>
              <span class="text-xs text-base-content/60">Kirim Pesan Gambar (Image)</span>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-4">
              <!-- Form Parameters -->
              <div class="space-y-3">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  <div>
                    <label class="label pb-1"><span class="label-text text-xs font-semibold">Session ID</span></label>
                    <input type="text" id="api-send-img-session" value="main" class="input input-bordered input-sm w-full font-mono text-xs">
                  </div>
                  <div>
                    <label class="label pb-1"><span class="label-text text-xs font-semibold">Nomor Tujuan (to)</span></label>
                    <input type="text" id="api-send-img-to" placeholder="6281234567890" class="input input-bordered input-sm w-full font-mono text-xs">
                  </div>
                </div>

                <div>
                  <label class="label pb-1"><span class="label-text text-xs font-semibold">URL Gambar (url)</span></label>
                  <input type="url" id="api-send-img-url" value="https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe" class="input input-bordered input-sm w-full font-mono text-xs" placeholder="https://domain.com/image.jpg">
                </div>

                <div>
                  <label class="label pb-1"><span class="label-text text-xs font-semibold">Caption Gambar (caption)</span></label>
                  <input type="text" id="api-send-img-caption" value="Contoh Gambar WhatsApp Gateway" class="input input-bordered input-sm w-full text-xs" placeholder="Keterangan gambar...">
                </div>

                <div class="flex justify-end pt-1">
                  <button id="btn-test-send-img" onclick="testSendImage()" class="btn btn-primary btn-sm text-xs font-semibold px-4">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                    </svg>
                    Kirim Gambar
                  </button>
                </div>
              </div>

              <!-- Response Box & cURL Reference -->
              <div class="space-y-2">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-bold text-base-content">Hasil Response:</span>
                  <div class="tabs tabs-boxed py-0 px-1 bg-base-200">
                    <button class="tab tab-xs tab-active" onclick="switchTab(this, 'resp-box-send-img', 'curl-box-send-img')">Response</button>
                    <button class="tab tab-xs" onclick="switchTab(this, 'curl-box-send-img', 'resp-box-send-img')">cURL</button>
                  </div>
                </div>
                <div id="resp-box-send-img">
                  <div class="rounded-lg border border-dashed border-base-300 bg-base-200/50 p-6 text-center text-xs text-base-content/60">
                    Isi parameter di samping dan klik "Kirim Gambar" untuk menguji pengiriman media gambar.
                  </div>
                </div>
                <div id="curl-box-send-img" class="hidden">
                  <div class="mockup-code text-xs">
                    <pre data-prefix="$"><code>curl -X POST http://localhost:5001/send-image \</code></pre>
                    <pre data-prefix=""><code>  -H "Content-Type: application/json" \</code></pre>
                    <pre data-prefix=""><code>  -d '{"session":"main","to":"6281234567890","caption":"Nice!","url":"https://example.com/image.jpg"}'</code></pre>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- 3. Send Document -->
        <div class="card bg-base-100 shadow-sm border border-base-300 api-card" data-category="message">
          <div class="card-body p-5 sm:p-6">
            <div class="flex flex-wrap items-center justify-between gap-2 pb-3 border-b border-base-300">
              <div class="flex items-center gap-2">
                <span class="badge badge-success font-mono font-bold text-xs text-white">POST</span>
                <code class="text-sm font-mono font-bold text-base-content">/send-document</code>
              </div>
              <span class="text-xs text-base-content/60">Kirim Berkas Dokumen (PDF, DOCX, dll.)</span>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-4">
              <!-- Form Parameters -->
              <div class="space-y-3">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  <div>
                    <label class="label pb-1"><span class="label-text text-xs font-semibold">Session ID</span></label>
                    <input type="text" id="api-send-doc-session" value="main" class="input input-bordered input-sm w-full font-mono text-xs">
                  </div>
                  <div>
                    <label class="label pb-1"><span class="label-text text-xs font-semibold">Nomor Tujuan (to)</span></label>
                    <input type="text" id="api-send-doc-to" placeholder="6281234567890" class="input input-bordered input-sm w-full font-mono text-xs">
                  </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  <div>
                    <label class="label pb-1"><span class="label-text text-xs font-semibold">URL Dokumen (url)</span></label>
                    <input type="url" id="api-send-doc-url" value="https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf" class="input input-bordered input-sm w-full font-mono text-xs" placeholder="https://domain.com/doc.pdf">
                  </div>
                  <div>
                    <label class="label pb-1"><span class="label-text text-xs font-semibold">Nama File (filename)</span></label>
                    <input type="text" id="api-send-doc-filename" value="document.pdf" class="input input-bordered input-sm w-full font-mono text-xs">
                  </div>
                </div>

                <div>
                  <label class="label pb-1"><span class="label-text text-xs font-semibold">Caption (opsional)</span></label>
