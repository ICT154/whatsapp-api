        <h3 class="font-bold">Phone Number Format</h3>
        <div class="text-xs">Use international format without '+' sign: <code>6281234567890</code> (Indonesia),
          <code>14155552671</code> (US)
        </div>
      </div>
    </div>
  </div>

  <!-- Footer -->
  <footer class="footer footer-center p-6 bg-base-300 text-base-content border-t border-base-200">
    <div class="flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-green-600" fill="currentColor" viewBox="0 0 24 24">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.569-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.686" />
      </svg>
      <span class="font-semibold text-sm">WhatsApp API Gateway</span>
      <span class="text-xs text-base-content/50">&bull; Panel Kontrol Sistem</span>
    </div>
  </footer>

  <script src="/p/js/theme-toggle.js"></script>
  <script>
    // Tab switcher between Response and cURL
    function switchTab(clickedTab, showId, hideId) {
      const parent = clickedTab.parentElement;
      parent.querySelectorAll('.tab').forEach(t => t.classList.remove('tab-active'));
      clickedTab.classList.add('tab-active');
      document.getElementById(showId).classList.remove('hidden');
      document.getElementById(hideId).classList.add('hidden');
    }

    // Category filter for API documentation cards
    function filterApiCards(category) {
      document.querySelectorAll('.api-filter-btn').forEach(btn => {
        if (btn.dataset.filter === category) {
          btn.classList.add('btn-active');
        } else {
          btn.classList.remove('btn-active');
        }
      });

      document.querySelectorAll('.api-card').forEach(card => {
        if (category === 'all' || card.dataset.category === category) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    }

    function escapeHtml(str) {
      return String(str)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    function copyCode(elementId, btn) {
      const el = document.getElementById(elementId);
      if (!el) return;
      navigator.clipboard.writeText(el.innerText).then(() => {
        const originalText = btn.innerHTML;
        btn.innerHTML = '<span>Tersalin!</span>';
        setTimeout(() => { btn.innerHTML = originalText; }, 1500);
      });
    }

    function createSession() {
      const sessionName = document.getElementById('sessionName').value.trim();
      if (!sessionName) {
        alert('Silakan masukkan nama sesi');
        return;
      }

      const url = `/start-session?session=${encodeURIComponent(sessionName)}&scan=true`;
      window.open(url, '_blank');
    }

    // Disconnect session
    async function disconnectSession(targetSession) {
      const sessionName = targetSession || document.getElementById('sessionName').value.trim() || 'main';

      if (!confirm(`Yakin ingin memutuskan sesi '${sessionName}'?\n\nKoneksi WhatsApp akan dihentikan dan kredensial lokal akan dihapus. Anda harus scan QR ulang jika ingin menautkan kembali.`)) {
        return;
      }

      const statusDiv = document.getElementById('sessionStatus');
      statusDiv.innerHTML = `
        <div class="flex items-center justify-center p-4">
          <div class="loading loading-spinner loading-sm mr-2 text-error"></div>
          <span class="text-xs text-base-content/70">Memutuskan koneksi sesi ${sessionName}...</span>
        </div>
      `;

      try {
        const response = await fetch('/delete-session', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ session: sessionName })
        });

        const data = await response.json();
        
        statusDiv.innerHTML = `
          <div class="alert alert-info text-xs py-3 px-4 rounded-lg flex items-center justify-between">
            <div class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-info" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>${data.message || `Sesi '${sessionName}' berhasil diputuskan.`}</span>
            </div>
            <button onclick="checkSessions()" class="btn btn-ghost btn-xs">Cek Sesi</button>
          </div>
        `;
      } catch (error) {
        statusDiv.innerHTML = `
          <div class="text-center py-3">
            <div class="text-error font-medium text-xs">Gagal Memutuskan Sesi</div>
            <div class="text-base-content/50 text-xs mt-0.5">${error.message}</div>
          </div>
        `;
      }
    }

    // Check active sessions
    async function checkSessions() {
      const statusDiv = document.getElementById('sessionStatus');

      statusDiv.innerHTML = `
        <div class="flex items-center justify-center p-4">
          <div class="loading loading-spinner loading-sm mr-2 text-primary"></div>
          <span class="text-xs text-base-content/70">Memeriksa daftar sesi...</span>
        </div>
      `;

      try {
        const configuredKey = '<%= apiKey || "" %>';
        const sessionsUrl = configuredKey ? `/sessions?key=${encodeURIComponent(configuredKey)}` : '/sessions';
        const response = await fetch(sessionsUrl, {
          method: 'GET',
          headers: { 'Content-Type': 'application/json' }
        });

        if (!(response.ok || response.status === 303)) {
          throw new Error(`HTTP error status: ${response.status}`);
        }

        const data = await response.json();

        if (data.data && Array.isArray(data.data)) {
          const sessions = data.data;
          if (sessions.length > 0) {
            statusDiv.innerHTML = `
              <div class="mb-3 flex items-center justify-between">
                <span class="font-semibold text-xs text-base-content">Sesi Terdaftar</span>
                <span class="badge badge-success badge-sm">${sessions.length} Aktif</span>
              </div>
              <div class="divide-y divide-base-300 rounded-lg overflow-hidden border border-base-300 bg-base-100 shadow-sm">
                ${sessions.map(session => `
                  <div class="flex justify-between items-center px-3 py-2 hover:bg-base-200/50 transition">
                    <div class="flex items-center gap-2">
                      <span class="font-mono text-xs font-semibold text-base-content">${session}</span>
                      <span class="badge badge-success badge-xs font-mono">connected</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                      <button onclick="setAndCheckDetail('${session}')" class="btn btn-ghost btn-xs text-[11px] h-6 min-h-0 px-2">Detail</button>
                      <button onclick="disconnectSession('${session}')" class="btn btn-error btn-outline btn-xs text-[11px] h-6 min-h-0 px-2">Disconnect</button>
                    </div>
                  </div>
                `).join('')}
              </div>
            `;
          } else {
            statusDiv.innerHTML = `
              <div class="text-center py-4">
                <div class="text-warning font-semibold text-xs mb-1">Tidak ada sesi aktif</div>
                <div class="text-[11px] text-base-content/60">Gunakan form "Mulai Sesi Baru" untuk menautkan nomor WhatsApp Anda.</div>
              </div>
            `;
          }
        } else {
          statusDiv.innerHTML = `
            <div class="text-center py-4">
              <div class="text-error font-medium text-xs">Gagal memuat sesi</div>
              <div class="text-xs text-base-content/60 mt-1">Respon server tidak valid.</div>
            </div>
          `;
        }
      } catch (error) {
        statusDiv.innerHTML = `
          <div class="text-center py-4">
            <div class="text-error font-medium text-xs">Kesalahan Koneksi</div>
            <div class="text-xs text-base-content/60 mt-1">${error.message}</div>
          </div>
        `;
      }
    }

    function setAndCheckDetail(name) {
      document.getElementById('sessionName').value = name;
      checkDetailedStatus(name);
    }

    // Check detailed session status
    async function checkDetailedStatus(targetSession) {
      const statusDiv = document.getElementById('sessionStatus');
      const sessionName = targetSession || document.getElementById('sessionName').value.trim() || 'main';

      statusDiv.innerHTML = `
        <div class="flex items-center justify-center p-4">
          <div class="loading loading-spinner loading-sm mr-2 text-primary"></div>
          <span class="text-xs text-base-content/70">Memeriksa status sesi ${sessionName}...</span>
        </div>
      `;

      try {
        const response = await fetch('/session-status', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ session: sessionName })
        });

        if (!response.ok) {
          throw new Error(`HTTP error status: ${response.status}`);
        }

        const data = await response.json();

        if (data.status || data.data) {
          const session = data.data || data;
          let statusBadge = '';

          switch (session.status) {
            case 'disconnected':
              statusBadge = 'badge-error';
              break;
            case 'connecting':
              statusBadge = 'badge-warning';
              break;
            case 'connected':
              statusBadge = 'badge-info';
              break;
            case 'syncing':
              statusBadge = 'badge-warning';
              break;
            case 'ready':
              statusBadge = 'badge-success';
              break;
            default:
              statusBadge = 'badge-neutral';
          }

          statusDiv.innerHTML = `
            <div class="space-y-2.5">
              <div class="flex items-center justify-between pb-2 border-b border-base-300">
                <div>
                  <span class="text-[11px] text-base-content/60 block">Session ID</span>
                  <span class="font-bold text-sm text-base-content font-mono">${session.session_id}</span>
                </div>
                <div class="badge ${statusBadge} font-mono font-medium uppercase text-[11px] px-2.5 py-2 text-white">
                  ${session.status}
                </div>
              </div>
              
              <div class="grid grid-cols-1 gap-1 text-xs">
                <div class="flex justify-between py-1 border-b border-base-300/40">
                  <span class="text-base-content/60">Keterangan:</span>
                  <span class="font-medium text-base-content text-right">${session.message}</span>
                </div>
                <div class="flex justify-between py-1 border-b border-base-300/40">
                  <span class="text-base-content/60">Siap Operasi:</span>
                  <span class="font-medium ${session.is_ready ? 'text-success' : 'text-error'}">
                    ${session.is_ready ? 'Ya (Ready)' : 'Tidak (Belum Siap)'}
                  </span>
                </div>
                <div class="flex justify-between py-1 border-b border-base-300/40">
                  <span class="text-base-content/60">Sesi Terdaftar:</span>
                  <span class="font-medium ${session.session_exists ? 'text-success' : 'text-error'}">
                    ${session.session_exists ? 'Ada' : 'Tidak Ditemukan'}
                  </span>
                </div>
                <div class="flex justify-between py-1">
                  <span class="text-base-content/60">Pemeriksaan:</span>
                  <span class="font-mono text-base-content/70">${new Date(session.timestamp).toLocaleTimeString()}</span>
                </div>
              </div>

              ${session.session_exists ? `
                <div class="pt-2">
                  <button onclick="disconnectSession('${session.session_id}')" class="btn btn-error btn-outline btn-xs w-full text-xs gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                    </svg>
                    Disconnect Sesi '${session.session_id}'
                  </button>
                </div>
              ` : ''}
            </div>
          `;
        } else {
          statusDiv.innerHTML = `
            <div class="text-center py-3">
              <div class="text-error font-medium text-xs">Gagal mengambil status sesi</div>
            </div>
          `;
        }
      } catch (error) {
        statusDiv.innerHTML = `
          <div class="text-center py-3">
            <div class="text-error font-medium text-xs">Kesalahan Koneksi</div>
            <div class="text-base-content/50 text-xs mt-0.5">${error.message}</div>
          </div>
        `;
      }
    }

    // Generic API test execution handler
    async function handleApiCall({ endpoint, method = 'POST', headers = {}, body = null, responseBoxId, buttonId }) {
      const btn = document.getElementById(buttonId);
      const box = document.getElementById(responseBoxId);
      const originalBtnContent = btn ? btn.innerHTML : '';
      
      if (btn) {
        btn.disabled = true;
        btn.innerHTML = `<span class="loading loading-spinner loading-xs mr-1"></span> Mengirim...`;
      }
      
      box.innerHTML = `
        <div class="flex flex-col items-center justify-center py-8 text-base-content/60">
          <span class="loading loading-spinner loading-md text-primary mb-2"></span>
          <span class="text-xs">Mengirim request ke ${endpoint}...</span>
        </div>
      `;
      
      const startTime = performance.now();
      try {
        const options = {
          method,
          headers: {
            'Content-Type': 'application/json',
            ...headers
          }
        };
        if (body && method !== 'GET') {
          options.body = typeof body === 'string' ? body : JSON.stringify(body);
        }
        
        const res = await fetch(endpoint, options);
        const duration = Math.round(performance.now() - startTime);
        const contentType = res.headers.get('content-type') || '';
        let responseData;
        if (contentType.includes('application/json')) {
          responseData = await res.json();
        } else {
          responseData = await res.text();
        }
        
        renderResponseBox(box, {
          status: res.status,
          statusText: res.statusText || (res.ok ? 'OK' : 'Error'),
          isSuccess: res.ok,
          duration,
          data: responseData
        });
      } catch (err) {
        const duration = Math.round(performance.now() - startTime);
        renderResponseBox(box, {
          status: 0,
          statusText: 'Koneksi Gagal',
          isSuccess: false,
          duration,
          data: { error: err.message || 'Gagal menghubungi server' }
        });
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = originalBtnContent;
        }
      }
    }

    function renderResponseBox(box, { status, statusText, isSuccess, duration, data }) {
      const jsonStr = typeof data === 'object' ? JSON.stringify(data, null, 2) : String(data);
      const badgeClass = isSuccess ? 'badge-success text-white' : 'badge-error text-white';
      const uniqueId = 'resp_' + Math.random().toString(36).substring(2, 9);

      box.innerHTML = `
        <div class="rounded-lg border border-base-300 bg-base-100 overflow-hidden shadow-sm">
          <div class="flex items-center justify-between px-3 py-2 bg-base-200 border-b border-base-300 text-xs">
            <div class="flex items-center gap-2">
              <span class="badge ${badgeClass} badge-sm font-mono font-bold">${status} ${statusText}</span>
              <span class="text-base-content/60 font-mono text-[11px]">${duration} ms</span>
            </div>
            <button type="button" onclick="copyCode('${uniqueId}', this)" class="btn btn-ghost btn-xs text-[11px] h-6 min-h-0 px-2 gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              <span>Salin</span>
            </button>
          </div>
          <div class="p-3 bg-neutral text-neutral-content overflow-x-auto max-h-64">
            <pre id="${uniqueId}" class="text-xs font-mono whitespace-pre leading-relaxed"><code>${escapeHtml(jsonStr)}</code></pre>
          </div>
        </div>
      `;
    }

    // Individual endpoint testers
    function testSendMessage() {
      const session = document.getElementById('api-send-msg-session').value.trim() || 'main';
      const to = document.getElementById('api-send-msg-to').value.trim();
      const text = document.getElementById('api-send-msg-text').value;
      const isGroup = document.getElementById('api-send-msg-group').checked;

      if (!to) {
        alert('Silakan masukkan nomor tujuan (to).');
        return;
      }

      handleApiCall({
        endpoint: '/send-message',
        method: 'POST',
        body: { session, to, text, isGroup },
        responseBoxId: 'resp-box-send-msg',
        buttonId: 'btn-test-send-msg'
      });
    }

    function testSendImage() {
      const session = document.getElementById('api-send-img-session').value.trim() || 'main';
      const to = document.getElementById('api-send-img-to').value.trim();
      const url = document.getElementById('api-send-img-url').value.trim();
      const caption = document.getElementById('api-send-img-caption').value;

      if (!to || !url) {
        alert('Silakan masukkan nomor tujuan dan URL gambar.');
        return;
      }

      handleApiCall({
        endpoint: '/send-image',
        method: 'POST',
        body: { session, to, url, caption },
        responseBoxId: 'resp-box-send-img',
        buttonId: 'btn-test-send-img'
      });
    }

    function testSendDocument() {
      const session = document.getElementById('api-send-doc-session').value.trim() || 'main';
      const to = document.getElementById('api-send-doc-to').value.trim();
      const url = document.getElementById('api-send-doc-url').value.trim();
      const filename = document.getElementById('api-send-doc-filename').value.trim() || 'document.pdf';
      const caption = document.getElementById('api-send-doc-caption').value;

      if (!to || !url) {
        alert('Silakan masukkan nomor tujuan dan URL dokumen.');
        return;
      }

      handleApiCall({
        endpoint: '/send-document',
        method: 'POST',
        body: { session, to, url, filename, caption },
        responseBoxId: 'resp-box-send-doc',
        buttonId: 'btn-test-send-doc'
      });
    }

    function testSendBulkMessage() {
      const session = document.getElementById('api-bulk-msg-session').value.trim() || 'main';
      const delay = parseInt(document.getElementById('api-bulk-msg-delay').value) || 1000;
      let data;
      try {
        data = JSON.parse(document.getElementById('api-bulk-msg-data').value);
      } catch (e) {
        alert('Format JSON data penerima tidak valid:\n' + e.message);
        return;
      }

      handleApiCall({
        endpoint: '/send-bulk-message',
        method: 'POST',
        body: { session, delay, data },
        responseBoxId: 'resp-box-bulk-msg',
        buttonId: 'btn-test-bulk-msg'
      });
    }

    function testSendBulkImage() {
      const session = document.getElementById('api-bulk-img-session').value.trim() || 'main';
      const delay = parseInt(document.getElementById('api-bulk-img-delay').value) || 1000;
      let data;
      try {
        data = JSON.parse(document.getElementById('api-bulk-img-data').value);
      } catch (e) {
        alert('Format JSON data gambar tidak valid:\n' + e.message);
        return;
      }

      handleApiCall({
        endpoint: '/send-bulk-image',
        method: 'POST',
        body: { session, delay, data },
        responseBoxId: 'resp-box-bulk-img',
        buttonId: 'btn-test-bulk-img'
      });
    }

    function testSendBulkDocument() {
      const session = document.getElementById('api-bulk-doc-session').value.trim() || 'main';
      const delay = parseInt(document.getElementById('api-bulk-doc-delay').value) || 1000;
      let data;
      try {
        data = JSON.parse(document.getElementById('api-bulk-doc-data').value);
      } catch (e) {
        alert('Format JSON data dokumen tidak valid:\n' + e.message);
        return;
      }

      handleApiCall({
        endpoint: '/send-bulk-document',
        method: 'POST',
        body: { session, delay, data },
        responseBoxId: 'resp-box-bulk-doc',
        buttonId: 'btn-test-bulk-doc'
      });
    }

    function testSessionStatusApi() {
      const session = document.getElementById('api-status-session').value.trim() || 'main';
      handleApiCall({
        endpoint: '/session-status',
        method: 'POST',
        body: { session },
        responseBoxId: 'resp-box-status',
        buttonId: 'btn-test-status'
      });
    }

    function testSessionsApi() {
      const key = document.getElementById('api-sessions-key').value.trim();
      const endpoint = key ? `/sessions?key=${encodeURIComponent(key)}` : '/sessions';
      handleApiCall({
        endpoint: endpoint,
        method: 'GET',
        responseBoxId: 'resp-box-sessions',
        buttonId: 'btn-test-sessions'
      });
    }

    function testDeleteSessionApi() {
      const session = document.getElementById('api-delete-session-name').value.trim() || 'main';
      if (!confirm(`Yakin ingin menghapus / memutuskan sesi '${session}'?\nData kredensial lokal sesi ini akan dihapus.`)) {
        return;
      }

      handleApiCall({
        endpoint: '/delete-session',
        method: 'POST',
        body: { session },
        responseBoxId: 'resp-box-delete',
        buttonId: 'btn-test-delete-session'
      });
    }
  </script>
</body>

</html>